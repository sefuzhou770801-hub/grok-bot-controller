--
-- Grok bot face: faithful port of bloub (github.com/jeremy-prt/bloub, MIT)
-- circle skin. Body is a perfect circle; the two capsule eyes are painted on
-- a sphere (face.ts eyePoses: yaw/pitch/roll head frame, per-eye tangent
-- projection). Every static expression below is the bloub expressions.ts
-- entry projected to screen space at ball radius 100 (centre 160,120):
--   NEUTRAL=neutre HAPPY=heureux SAD=triste ANGRY=colere DOUBT=mefiant
--   SLEEPY=somnolent LISTENING=attentif EXCITED=excite CURIOUS=curieux
--   CONFUSED=confus SURPRISED=surpris DIZZY=effraye(+spin) AFFECTION=hilare
--   BORED=blase; THINKING is ours, built with the same parameter model.
-- Persistent listening/thinking/sleepy/bored motion layers stay from #4.

----------------------------------------------------------------------
-- One triangle in a capsule-eye fan. Blink and expression openness compress
-- only screen-space Y around the eye centre, matching the measured blink.
----------------------------------------------------------------------
fn eye_wedge(cx, cy, x1, y1, x2, y2, openness, color)
  let sy1 = cy + (y1 - cy) * openness
  let sy2 = cy + (y2 - cy) * openness
  fill_triangle(cx, cy, x1, sy1, x2, sy2, color)
end

----------------------------------------------------------------------
-- Rounded capsule approximated by a ten-sided convex fan. `lid` is the
-- per-eye open amount (firmware blink, or a DSL wink that holds the
-- other eye open).
----------------------------------------------------------------------
fn capsule_eye(cx, cy, half_segment, radius, dx, dy, expression_open, lid, color)
  let openness = clamp(lid * expression_open, 0.06, 1)
  let px = -dy
  let py = dx
  let diagonal = 0.70710678

  let txc = cx - dx * half_segment
  let tyc = cy - dy * half_segment
  let bxc = cx + dx * half_segment
  let byc = cy + dy * half_segment

  let x0 = txc + px * radius
  let y0 = tyc + py * radius
  let x1 = txc + (px - dx) * radius * diagonal
  let y1 = tyc + (py - dy) * radius * diagonal
  let x2 = txc - dx * radius
  let y2 = tyc - dy * radius
  let x3 = txc - (px + dx) * radius * diagonal
  let y3 = tyc - (py + dy) * radius * diagonal
  let x4 = txc - px * radius
  let y4 = tyc - py * radius

  let x5 = bxc - px * radius
  let y5 = byc - py * radius
  let x6 = bxc + (dx - px) * radius * diagonal
  let y6 = byc + (dy - py) * radius * diagonal
  let x7 = bxc + dx * radius
  let y7 = byc + dy * radius
  let x8 = bxc + (px + dx) * radius * diagonal
  let y8 = byc + (py + dy) * radius * diagonal
  let x9 = bxc + px * radius
  let y9 = byc + py * radius

  eye_wedge(cx, cy, x0, y0, x1, y1, openness, color)
  eye_wedge(cx, cy, x1, y1, x2, y2, openness, color)
  eye_wedge(cx, cy, x2, y2, x3, y3, openness, color)
  eye_wedge(cx, cy, x3, y3, x4, y4, openness, color)
  eye_wedge(cx, cy, x4, y4, x5, y5, openness, color)
  eye_wedge(cx, cy, x5, y5, x6, y6, openness, color)
  eye_wedge(cx, cy, x6, y6, x7, y7, openness, color)
  eye_wedge(cx, cy, x7, y7, x8, y8, openness, color)
  eye_wedge(cx, cy, x8, y8, x9, y9, openness, color)
  eye_wedge(cx, cy, x9, y9, x0, y0, openness, color)
end

----------------------------------------------------------------------
-- Expression mixing. Each expression is a projected bloub pose: capsule
-- half-segment/cap radius (px at ball r=100), long-axis unit direction,
-- openness, and the eye-centre offset from the neutre rest position.
-- C++ owns the from/to ease and two nested holds; this mixes four weighted
-- parameter sets as a pure function of the current frame.
----------------------------------------------------------------------
fn grok_eyes(scale, color, ox, oy, left_lid, right_lid, sx, sy)
  let gx = gaze_h * sz(4) + ox
  let gy = gaze_v * sz(3) + oy
  let left_x = tx(160) + (tx(178.9) - tx(160)) * sx + gx
  let left_y = ty(120) + (ty(79.1) - ty(120)) * sy + gy
  let right_x = tx(160) + (tx(221.82) - tx(160)) * sx + gx
  let right_y = ty(120) + (ty(68.57) - ty(120)) * sy + gy
  let b = clamp(expr_blend, 0, 1)
  let hb = clamp(expr_hold_blend, 0, 1)
  let hb2 = clamp(expr_hold2_blend, 0, 1)

  let lhs = 0
  let lr = 0
  let ldx = 0
  let ldy = 0
  let lo = 0
  let lx = 0
  let ly = 0
  let rhs = 0
  let rr = 0
  let rdx = 0
  let rdy = 0
  let ro = 0
  let rx = 0
  let ry = 0

  let i = 0
  while i < 4 do
    let e = expr_from
    let w = (1 - hb2) * (1 - hb) * (1 - b)
    if i == 1 then
      e = expr_hold2_to
      w = hb2 * (1 - hb) * (1 - b)
    elif i == 2 then
      e = expr_hold_to
      w = hb * (1 - b)
    elif i == 3 then
      e = expr
      w = b
    end

    -- NEUTRAL = bloub neutre (defaults)
    let p_lhs = 10.86
    let p_lr = 8.77
    let p_ldx = 0.44
    let p_ldy = 0.9
    let p_lo = 1
    let p_lx = 0
    let p_ly = 0
    let p_rhs = 13.43
    let p_rr = 6.2
    let p_rdx = 0.44
    let p_rdy = 0.9
    let p_ro = 1
    let p_rx = 0
    let p_ry = 0
    if e == HAPPY then
      -- bloub heureux
      p_lhs = 4.66
      p_lr = 8.46
      p_ldx = 0.98
      p_ldy = 0.2
      p_lx = -39.79
      p_ly = 25.94
      p_rhs = 3.9
      p_rr = 8.48
      p_rdx = 0.98
      p_rdy = -0.21
      p_rx = -24.46
      p_ry = 36.47
    elif e == SAD then
      -- bloub triste
      p_lhs = 9.41
      p_lr = 10.5
      p_ldx = 0.45
      p_ldy = 0.89
      p_lx = -41.52
      p_ly = 62.53
      p_rhs = 9.83
      p_rr = 10.14
      p_rdx = -0.46
      p_rdy = 0.89
      p_rx = -29.39
      p_ry = 73.05
    elif e == ANGRY then
      -- bloub colere
      p_lhs = 8.88
      p_lr = 7.5
      p_ldx = 0.88
      p_ldy = 0.48
      p_lx = -43.13
      p_ly = 29.25
      p_rhs = 8.41
      p_rr = 7.48
      p_rdx = -0.87
      p_rdy = 0.5
      p_rx = -27.65
      p_ry = 39.78
    elif e == DOUBT then
      -- bloub mefiant
      p_lhs = 9.45
      p_lr = 10.48
      p_ldx = 0.12
      p_ldy = 0.99
      p_lx = -25.77
      p_ly = 33.72
      p_rhs = 2.19
      p_rr = 7.48
      p_rdx = 1
      p_rdy = -0.08
      p_rx = -15.19
      p_ry = 38.52
    elif e == SLEEPY then
      -- bloub somnolent
      p_lhs = 10.89
      p_lr = 9.84
      p_ldx = 0.04
      p_ldy = 1
      p_lo = 0.42
      p_lx = -36.37
      p_ly = 57.37
      p_rhs = 11.41
      p_rr = 9.32
      p_rdx = 0.04
      p_rdy = 1
      p_ro = 0.42
      p_rx = -24.49
      p_ry = 65.04
    elif e == LISTENING then
      -- bloub attentif
      p_lhs = 11.64
      p_lr = 10.29
      p_ldx = 0.08
      p_ldy = 1
      p_lx = -39.64
      p_ly = 34.44
      p_rhs = 12.08
      p_rr = 9.85
      p_rdx = 0.08
      p_rdy = 1
      p_rx = -27.72
      p_ry = 41.14
    elif e == THINKING then
      -- ours, bloub parameter model (gaze up-left, narrowed asymmetric)
      p_lhs = 8.82
      p_lr = 8.56
      p_ldx = 0.11
      p_ldy = 0.99
      p_lx = -69.67
      p_ly = 10.57
      p_rhs = 4.9
      p_rr = 11
      p_rdx = -0.1
      p_rdy = 0.99
      p_rx = -60.96
      p_ry = 15.85
    elif e == EXCITED then
      -- bloub excite
      p_lhs = 8.14
      p_lr = 19.3
      p_ldx = 0.15
      p_ldy = 0.99
      p_lx = -42.54
      p_ly = 63.71
      p_rhs = 9.82
      p_rr = 17.8
      p_rdx = -0.18
      p_rdy = 0.98
      p_rx = -19.06
      p_ry = 74.23
    elif e == CURIOUS then
      -- bloub curieux
      p_lhs = 10.54
      p_lr = 11.96
      p_ldx = 0.35
      p_ldy = 0.94
      p_lx = -19.48
      p_ly = 63.16
      p_rhs = 9.31
      p_rr = 8.92
      p_rdx = 0.33
      p_rdy = 0.94
      p_rx = -9.02
      p_ry = 59.17
    elif e == CONFUSED then
      -- bloub confus
      p_lhs = 12.9
      p_lr = 8.76
      p_ldx = 0.12
      p_ldy = 0.99
      p_lx = -69.3
      p_ly = 31.94
      p_rhs = 5.49
      p_rr = 8.5
      p_rdx = 0.92
      p_rdy = 0.38
      p_rx = -57.74
      p_ry = 50.36
    elif e == SURPRISED then
      -- bloub surpris
      p_lhs = 1.84
      p_lr = 21.63
      p_ldx = 0
      p_ldy = 1
      p_lx = -46.47
      p_ly = 45.85
      p_rhs = 2.6
      p_rr = 20.87
      p_rdx = 0
      p_rdy = 1
      p_rx = -24.36
      p_ry = 56.38
    elif e == DIZZY then
      -- bloub effraye; the live spin below keeps the dizzy read
      p_lhs = 9.09
      p_lr = 19.1
      p_ldx = -0.01
      p_ldy = 1
      p_lx = -50.83
      p_ly = 72.94
      p_rhs = 9.55
      p_rr = 18.65
      p_rdx = -0.01
      p_rdy = 1
      p_rx = -23.74
      p_ry = 83.47
    elif e == AFFECTION then
      -- bloub hilare
      p_lhs = 9.78
      p_lr = 6.43
      p_ldx = 0.96
      p_ldy = 0.27
      p_lx = -43.29
      p_ly = 17.89
      p_rhs = 8.91
      p_rr = 6.47
      p_rdx = 0.96
      p_rdy = -0.29
      p_rx = -24.55
      p_ry = 28.42
    elif e == BORED then
      -- bloub blase
      p_lhs = 5.83
      p_lr = 6
      p_ldx = 1
      p_ldy = -0.01
      p_lx = -80.44
      p_ly = 37.55
      p_rhs = 8.92
      p_rr = 6
      p_rdx = 1
      p_rdy = 0.01
      p_rx = -72.25
      p_ry = 48.08
    end

    lhs = lhs + p_lhs * w
    lr = lr + p_lr * w
    ldx = ldx + p_ldx * w
    ldy = ldy + p_ldy * w
    lo = lo + p_lo * w
    lx = lx + p_lx * w
    ly = ly + p_ly * w
    rhs = rhs + p_rhs * w
    rr = rr + p_rr * w
    rdx = rdx + p_rdx * w
    rdy = rdy + p_rdy * w
    ro = ro + p_ro * w
    rx = rx + p_rx * w
    ry = ry + p_ry * w
    i = i + 1
  end

  let llen = sqrt(ldx * ldx + ldy * ldy)
  if llen > 0.0001 then
    ldx = ldx / llen
    ldy = ldy / llen
  end
  let rlen = sqrt(rdx * rdx + rdy * rdy)
  if rlen > 0.0001 then
    rdx = rdx / rlen
    rdy = rdy / rlen
  end

  -- Dizzy loop: spin both capsules while the live expression is Dizzy.
  if expr == DIZZY then
    let spin = floor((now_ms / 90) % 8)
    let sdx = 1
    let sdy = 0
    if spin == 1 then
      sdx = 0.70710678
      sdy = 0.70710678
    elif spin == 2 then
      sdx = 0
      sdy = 1
    elif spin == 3 then
      sdx = -0.70710678
      sdy = 0.70710678
    elif spin == 4 then
      sdx = -1
      sdy = 0
    elif spin == 5 then
      sdx = -0.70710678
      sdy = -0.70710678
    elif spin == 6 then
      sdx = 0
      sdy = -1
    elif spin == 7 then
      sdx = 0.70710678
      sdy = -0.70710678
    end
    ldx = sdx
    ldy = sdy
    rdx = -sdx
    rdy = sdy
  end

  -- Persistent listening: slow tilt rock so the pose is not a freeze-frame.
  if expr == LISTENING then
    let rock_t = (now_ms / 90) % 40
    let rock = rock_t
    if rock_t > 20 then
      rock = 40 - rock_t
    end
    rock = (rock - 10) / 10 * 0.12
    ldx = ldx + rock
    rdx = rdx - rock
  end

  -- Persistent thinking: gaze drifts up and a slow blink.
  if expr == THINKING then
    let drift_t = (now_ms / 80) % 60
    let drift = drift_t
    if drift_t > 30 then
      drift = 60 - drift_t
    end
    ly = ly - drift / 30 * 2
    ry = ry - drift / 30 * 2
    let bt = (now_ms / 40) % 80
    let lid = 1
    if bt > 70 then
      lid = (80 - bt) / 10
      if lid < 0.35 then
        lid = 0.35
      end
    elif bt > 62 then
      lid = 0.35 + (70 - bt) / 8 * 0.65
    end
    lo = lo * lid
    ro = ro * lid
  end

  -- 与上方眼睛段的归一化同形：DSL 函数只有单返回值，双分量抽不成共享函数，保留两段。
  let nlen = sqrt(ldx * ldx + ldy * ldy)
  if nlen > 0.0001 then
    ldx = ldx / nlen
    ldy = ldy / nlen
  end
  let nrlen = sqrt(rdx * rdx + rdy * rdy)
  if nrlen > 0.0001 then
    rdx = rdx / nrlen
    rdy = rdy / nrlen
  end

  capsule_eye(left_x + lx * canvas_scale * sx, left_y + ly * canvas_scale * sy,
              sz(lhs) * scale, sz(lr) * scale,
              ldx, ldy, lo, left_lid, color)
  capsule_eye(right_x + rx * canvas_scale * sx, right_y + ry * canvas_scale * sy,
              sz(rhs) * scale, sz(rr) * scale,
              rdx, rdy, ro, right_lid, color)
end

----------------------------------------------------------------------
-- Axis-aligned ellipse via scanlines. Used for speech squash so the
-- resting circle does not become a 16-gon the moment the mouth opens.
----------------------------------------------------------------------
fn fill_ellipse(cx, cy, rx, ry, color)
  let y = -ry
  while y <= ry do
    let ny = y / ry
    let inside = 1 - ny * ny
    if inside > 0 then
      let hw = rx * sqrt(inside)
      fill_rect(cx - hw, cy + y, hw * 2 + 1, 1, color)
    end
    y = y + 1
  end
end

----------------------------------------------------------------------
-- Entry point. RGB565（黑底白表情，2026-08-29 老板定案）:
--   0x0000  = black background
--   0xFFFF  = white face body
--   0x0000  = black eyes (cut-out look on the white face)
--
-- The body never morphs: bloub circle skin, boss's round-shape rule.
-- Speech: 14% vertical squash, 4% horizontal stretch, no overshoot.
-- Clocks (incommensurate periods, offsets so t=0 is idle):
--   blink hijack  9700 ms windows, kinds 0/1/3 both, 2 left wink, 4 right wink
--   orbit         period 17900 offset 5900 duration 1200
----------------------------------------------------------------------
fn draw()
  let paper = 0x0000
  let body = 0xFFFF
  let eyes = 0x0000

  let talk = clamp(mouth_open, 0, 1)
  let sx = 1 + talk * 0.04
  let sy = 1 - talk * 0.14

  -- Firmware blinks stay binocular in most windows; some windows keep one
  -- eye open so the same blink reads as a wink. Period 9700 is off the
  -- other clocks so the pattern does not march.
  let left_lid = eye_open
  let right_lid = eye_open
  let kind = floor((now_ms + 4100) / 9700) % 5
  if kind == 2 then
    right_lid = 1
  elif kind == 4 then
    left_lid = 1
  end

  -- Sleepy: extra slow lid droop on top of the static pose.
  if expr == SLEEPY then
    let d = (now_ms / 120) % 50
    if d > 25 then
      d = 50 - d
    end
    let extra = 0.55 + d / 25 * 0.25
    left_lid = left_lid * extra
    right_lid = right_lid * extra
  end

  -- Eye orbit: 8-segment circle, amplitude fades in and out.
  let ox = 0
  let oy = 0
  let ot = (now_ms + 5900) % 17900
  if ot < 1200 then
    let p = ot / 1200
    let env = 1
    if p < 0.12 then
      env = p / 0.12
    elif p > 0.88 then
      env = (1 - p) / 0.12
    end
    let amp = sz(12) * env
    let u = p * 8
    let seg = floor(u)
    let f = u - seg
    let ax = 1
    let ay = 0
    let bx = 0.70710678
    let by = 0.70710678
    if seg == 1 then
      ax = 0.70710678
      ay = 0.70710678
      bx = 0
      by = 1
    elif seg == 2 then
      ax = 0
      ay = 1
      bx = -0.70710678
      by = 0.70710678
    elif seg == 3 then
      ax = -0.70710678
      ay = 0.70710678
      bx = -1
      by = 0
    elif seg == 4 then
      ax = -1
      ay = 0
      bx = -0.70710678
      by = -0.70710678
    elif seg == 5 then
      ax = -0.70710678
      ay = -0.70710678
      bx = 0
      by = -1
    elif seg == 6 then
      ax = 0
      ay = -1
      bx = 0.70710678
      by = -0.70710678
    elif seg == 7 then
      ax = 0.70710678
      ay = -0.70710678
      bx = 1
      by = 0
    end
    ox = (ax + (bx - ax) * f) * amp
    oy = (ay + (by - ay) * f) * amp
  end

  -- Bored: continuous slow look-around, independent of the burst orbit.
  if expr == BORED then
    let hx = (now_ms / 80) % 80
    if hx > 40 then
      hx = 80 - hx
    end
    let vy = (now_ms / 110) % 60
    if vy > 30 then
      vy = 60 - vy
    end
    ox = (hx - 20) / 20 * sz(14)
    oy = (vy - 15) / 15 * sz(8)
  end

  fill_rect(0, 0, canvas_w, canvas_h, paper)
  begin_group(0, 0, canvas_w, canvas_h)

  let cx = tx(160)
  let cy = ty(120)
  let b = clamp(expr_blend, 0, 1)
  let hb = clamp(expr_hold_blend, 0, 1)
  let hb2 = clamp(expr_hold2_blend, 0, 1)
  let body_scale_mix = 0
  let mix_i = 0
  while mix_i < 4 do
    let e = expr_from
    let w = (1 - hb2) * (1 - hb) * (1 - b)
    if mix_i == 1 then
      e = expr_hold2_to
      w = hb2 * (1 - hb) * (1 - b)
    elif mix_i == 2 then
      e = expr_hold_to
      w = hb * (1 - b)
    elif mix_i == 3 then
      e = expr
      w = b
    end
    let s = 1
    if e == EXCITED then
      s = 1.06
    elif e == SURPRISED then
      s = 1.05
    elif e == HAPPY then
      s = 1.03
    elif e == LISTENING then
      s = 1.01
    elif e == CURIOUS then
      s = 1.02
    elif e == CONFUSED then
      s = 0.995
    elif e == SLEEPY then
      s = 0.97
    elif e == SAD then
      s = 0.98
    elif e == THINKING then
      s = 0.99
    elif e == DIZZY then
      s = 1.02
    elif e == AFFECTION then
      s = 1.01
    elif e == BORED then
      s = 0.985
    end
    body_scale_mix = body_scale_mix + s * w
    mix_i = mix_i + 1
  end
  let base_r = sz(100) * body_scale_mix
  let eye_scale = (sx + sy) / 2

  if talk > 0.05 then
    fill_ellipse(cx, cy, base_r * sx, base_r * sy, body)
  else
    fill_circle(cx, cy, base_r, body)
  end
  grok_eyes(eye_scale, eyes, ox, oy, left_lid, right_lid, sx, sy)
  end_group()
end
